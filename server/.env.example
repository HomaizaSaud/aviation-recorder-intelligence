# PostgreSQL connection string
DATABASE_URL=postgres://main_user:pass@127.0.0.1:5432/cvr_fdr_analyzer

# Uncomment if your Postgres provider requires SSL
# PGSSLMODE=require

# MinIO / S3-compatible object storage
# URL of the MinIO server, including protocol (e.g. http://127.0.0.1)
MINIO_ENDPOINT=http://127.0.0.1:9000    # or http://192.168.10.15:9000 if others use it
MINIO_ACCESS_KEY=fdradmin
MINIO_SECRET_KEY=supersecret123
MINIO_REGION=us-east-1
MINIO_BUCKET=fdr-cvr-data   
# Whether to use HTTPS when contacting MinIO. Defaults to true when the
# endpoint URL starts with https, otherwise false.
# MINIO_USE_SSL=false
# Public base URL used to expose uploaded files. Override only if MinIO is
# fronted by a CDN or reverse proxy. Defaults to the endpoint value above.
# MINIO_PUBLIC_BASE_URL=https://files.example.com
# Expiration, in seconds, for presigned upload/download URLs.
# MINIO_UPLOAD_EXPIRY_SECONDS=900
# MINIO_DOWNLOAD_EXPIRY_SECONDS=300

