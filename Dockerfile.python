FROM python:3.11-slim

WORKDIR /app

# System deps needed for torch, numpy, and audio processing
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libsndfile1 \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better layer caching
COPY python_model/requirements.txt ./requirements.txt

# Install ALL required packages
# (inference_service.py needs more than requirements.txt currently lists)
RUN pip install --no-cache-dir \
    "pandas>=2.0,<3.0" \
    numpy \
    "fastapi>=0.100.0" \
    "uvicorn[standard]>=0.22.0" \
    "pydantic>=2.0" \
    "joblib>=1.3.0" \
    "scikit-learn>=1.3.0" \
    "torch>=2.0" \
    "torchaudio>=2.0" \
    "transformers>=4.30"

# Copy all python model source files
COPY python_model/ ./

EXPOSE 8000

# inference_service.py is the FastAPI entry point (runs on port 8000)
CMD ["uvicorn", "inference_service:app", "--host", "0.0.0.0", "--port", "8000"]
